# EmberEye Environment Configuration
# Development: Copy to .env and fill in your API keys
# Production: Set these in your hosting environment

# Weather API Key (required)
# Get from: https://openweathermap.org/api
WEATHER_API_KEY=your_weather_api_key_here

# API Configuration
DEBUG=True  # Set to False in production
API_HOST=0.0.0.0
API_PORT=8000

# Security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # Comma-separated URLs
# Production example: CORS_ORIGINS=https://your-frontend-domain.com

# Logging
LOG_LEVEL=INFO  # Use ERROR in production

# Model Configuration
MODEL_PATH=models/wildfire_cnn_model.h5
API_HOST=localhost
API_PORT=8000

# Development Settings
DEBUG=True
LOG_LEVEL=INFO

# Model Configuration
MODEL_PATH=models/wildfire_cnn_model_new.h5
