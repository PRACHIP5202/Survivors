# Frontend Environment Variables
# Development: Copy to .env and fill in your API keys
# Production: Copy to .env.production before building

# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1  # Development
# VITE_API_BASE_URL=https://your-backend-url.com/api/v1  # Production

# OpenWeatherMap API Key (required)
# Get from: https://openweathermap.org/api
VITE_WEATHER_API_KEY=your_weather_api_key_here

# Feature Flags (Production)
VITE_ENABLE_ANALYTICS=false  # Set to true in production
VITE_ENABLE_FEEDBACK_FORM=true

# Map Configuration
VITE_MAP_DEFAULT_LAT=37.7749
VITE_MAP_DEFAULT_LNG=-122.4194
VITE_MAP_DEFAULT_ZOOM=10

# Application Settings
VITE_APP_NAME=EmberEye
VITE_APP_VERSION=1.0.0
